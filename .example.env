# Telegram account credentials (required)
API_ID=
API_HASH=
SESSION_NAME=

# AI integration (leave empty to disable AI features)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Database
DATABASE_URL=sqlite+aiosqlite:///data/app.db

# Timezone used for display and scheduling
TIMEZONE=Asia/Tehran

# Owner / permissions
OWNER_ID=
SESSION_STRING=

# Downloader
DOWNLOAD_DIR=downloads
MAX_DOWNLOAD_SIZE_MB=500
DOWNLOAD_TIMEOUT=300

# External service keys (optional)
WEATHER_API_KEY=
URL_SHORTENER_API_KEY=

# Logging
LOG_LEVEL=INFO

# Prefix for commands
COMMAND_PREFIX=@